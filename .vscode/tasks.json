{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build --nologo",
      "options": {
        "cwd": "${workspaceFolder}/ticketing-system/backend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: watch",
      "type": "shell",
      "command": "dotnet watch run",
      "options": {
        "cwd": "${workspaceFolder}/ticketing-system/backend"
      },
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/ticketing-system/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
